 "lyrics": {
  "17517": "舞い 祈れ 舞い 願え\n起舞吧 祈祷吧 起舞吧 祈愿吧",
  "20467": "勇往邁進 頂まで\n勇往直前 直至顶峰",
  "23667": "舞い 祈れ 舞い 願え\n起舞吧 祈祷吧 起舞吧 祈愿吧",
  "26850": "前途洋々 称え捧げ\n前程似锦 奉上赞颂",
  "30150": "時代の間に 響くはその名を呼ぶ声\n时代流转间 回响着呼唤其名的声音",
  "36633": "歴史は変われど 巡り続ける\n纵使历史变迁 亦将不断轮回流转",
  "42750": "点を辿り結ぶ 線で紐解く“理由”\n点滴相连 循线解开其中的“因由”",
  "46110": "キミがいてこその私ならば\n因为有你相伴 才成就了如今的我",
  "49417": "その祈り 応えゆく 宿し力と変えて\n我定会回应那份祈愿 将其化作宿于体内的力量",
  "56283": "(Ha…Ha…) 舞い 祈れ 舞い 願え\n(Ha…Ha…) 起舞吧 祈祷吧 起舞吧 祈愿吧",
  "61483": "(Ha…Ha…) 舞い 祈れ 舞い 願え\n(Ha…Ha…) 起舞吧 祈祷吧 起舞吧 祈愿吧",
  "68000": "勇往邁進 頂まで\n勇往直前 直至顶峰",
  "71783": "舞い 祈れ 舞い 願え\n起舞吧 祈祷吧 起舞吧 祈愿吧",
  "74617": "前途洋々 称え捧げ\n前程似锦 奉上赞颂",
  "78150": "舞い踊れ\n翩跹起舞",
  "80467": "時代は 百花繚乱 百花繚乱 縁を紡いで\n时代正百花缭乱 百花齐放 织就牵绊的缘分",
  "84183": "「セーノッ・セー」 声高らかに\n「预备——起！」放声高呼",
  "87283": "百花繚乱 百花繚乱 恩に報いて\n百花缭乱 百花齐放 报答深恩",
  "90350": "光満つ 明日を射抜け\n贯穿光芒满溢的明日",
  "93700": "祈れや 祈れや 絆たるや\n祈愿吧 祈愿吧 这份牵绊",
  "96667": "叫べや 叫べや 名を呼ぶ声\n呐喊吧 呐喊吧 呼唤名字之声",
  "100117": "百花繚乱 百花繚乱 殊に輝き\n百花缭乱 百花齐放 格外璀璨",
  "103283": "受け取りし 奇跡起こせ\n秉承心意 化作奇迹",
  "106633": "舞い 祈れ 舞い 願え\n起舞吧 祈祷吧 起舞吧 祈愿吧",
  "109667": "勇往邁進 頂まで\n勇往直前 直至顶峰",
  "112883": "舞い 祈れ 舞い 願え\n起舞吧 祈祷吧 起舞吧 祈愿吧",
  "115917": "前途洋々 称え捧げ\n前程似锦 奉上赞颂"
 },
