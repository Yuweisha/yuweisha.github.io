  "lyrics": {
    "3617": "声なき声 不可思議\n众人之声 不可思议",
    "7133": "そのとき風 揺らめき\n狂作之风 摇摆飘逸",
    "10900": "もがいていた背中を押す\n苦苦挣扎的身影 在背后推一把",
    "17733": "超えたい壁 gravity\n欲破之壁 gravity",
    "21267": "そのとき羽 煌めき\n舒展之翼 光彩熠熠",
    "24967": "もう過負荷は次元変換transforming\n过载后 维度变换 transforming",
    "45967": "誰も見たことのない景色へ\n向着无人知晓的景色",
    "49500": "何も視界にいない世界へ\n向着一望无际的世界",
    "53033": "限界超えた異次元 on the road\n超越极限的异次元 on the road",
    "56550": "選び 加速して行こう別のリアルへ\n选择吧 向着另一个现实加速前进",
    "60967": "誰も遮ることなく\n无人可以阻挡",
    "63617": "何も恐れるものない進化へ\n进化成无所畏惧的自己",
    "67150": "標識の無い領域の中へ\n前往未知的领域",
    "70683": "移行 不可能 可能に変えて\n转换 在不可能与可能之间",
    "74633": "Go 目の前の世界線を追い越して\nGo 赶超前方的世界线",
    "103517": "見えない光に導かれ ベクトルを変えて行け\n被陌生的光芒指引 转变方向的向量",
    "117067": "果てない瞬間 [生命]<いのち>ごとレベル上げて\n无限的瞬间 连同生命一起提升等级",
    "129150": "真っ直ぐに\n勇往直前",
    "134417": "さあ 走れ奇跡\n奔跑起来吧 奇迹之人",
    "144767": "声なき声 轟き\n众人之声 震天动地",
    "148317": "彼方の[天]<そら> 閃き\n繁星若灯 生辉熠熠",
    "152067": "あの魂 私を押す\n那灵魂 推着我前行",
    "158917": "超えてた壁 その[瞬間]<とき>\n穿破之壁 关键之际",
    "162433": "数多のほら 響めき\n侧耳聆听 群声化",
    "166133": "もう新たな宇宙 未知なるゴールへ\n前往全新的宇宙 冲破未知的终点线"
  },
