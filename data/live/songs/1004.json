  "lyrics": {
    "13933": "[前]<まえ>だけを[見]<み>て ひたすらにボクは[進]<すす>む\n看向前方 决意前行",
    "21083": "Never Looking Back そう[決]<け>して\nNever Looking Back 下定决心",
    "24750": "[振]<ふ>り[向]<む>かず [未来]<みらい>へ\n永不回头 走向未来",
    "44700": "[降]<ふ>り[止]<と>まぬ[雨]<あめ>が [行]<ゆ>く[手]<て>[阻]<はば>もうと\n即使被连绵的阴雨挡住去路",
    "51667": "この[決意]<おもい>は [消]<け>せはしない\n这份决意也不会就此消失",
    "57933": "[煙]<けむ>る[視界]<しかい>も ぬかるんだ[足元]<あしもと>も\n即便视野模糊 脚踏泥泞",
    "64267": "ボクを[止]<と>めるなんて[絶対]<ぜったい> [出来]<でき>ないから\n我的脚步也绝不会被阻止",
    "72667": "[思]<おも>い[通]<とお>りにいかなくて [泣]<な>きたい[日]<ひ>も\n即便那天未能如愿取胜而落泪",
    "78800": "Don't Give It Up [信]<しん>じてる\nDon't Give It Up 相信自己",
    "82050": "[胸]<むね>を[焦]<こ>がす[情熱]<じょうねつ>\n相信心中燃烧的热情",
    "85117": "[約束]<やくそく>しよう もし[何]<なに>を[試]<ため>されても\n来约定吧 无论遇到什么考验",
    "91500": "Never Looking Back そう[決]<け>して\nNever Looking Back 下定决心",
    "94683": "[振]<ふ>り[向]<む>かず Believe Myself\n永不回头 Believe Myself"
  },
