  "lyrics": {
    "19220": "[光]<ひかり>の[速]<はや>さで[駆]<か>け[抜]<ぬ>ける[衝動]<しょうどう>は\n那份光速般疾驰的冲动",
    "24180": "[何]<なに>を[犠牲]<ぎせい>にしても[叶]<かな>えたい[強]<つよ>さの[覚悟]<かくご>\n是不计一切代价也要变强的觉悟",
    "28970": "(no fear) [一度]<いちど>きりの\n(无畏) 在仅有一次的",
    "31450": "(trust you) この[瞬間]<しゅんかん>に\n(信任) 这个瞬间",
    "34080": "[賭]<か>けてみろ [自分]<じぶん>を[信]<しん>じて\n赌上一切 相信自我",
    "39030": "[時]<とき>には[運]<うん>だって[必要]<ひつよう>と[言]<い>うのなら\n在需要运气降临的时刻",
    "43720": "[宿命]<しゅくめい>の[旋律]<せんりつ>も[引]<ひ>き[寄]<よ>せてみせよう\n我将亲自牵起宿命的旋律",
    "53200": "[走]<はし>れ[今]<いま>を まだ[終]<お>われない\n奔跑起来吧 还不能停步",
    "56380": "[辿]<たど>り[着]<つ>きたい[場所]<ばしょ>があるから\n因为我仍有未能达成的目标",
    "60100": "その[先]<さき>へと[進]<すす>め\n我将朝着未来前行",
    "63020": "[涙]<なみだ>さえも[強]<つよ>く[胸]<むね>に[抱]<だ>きしめ\n即使落泪也将其紧紧拥在怀中",
    "69020": "そこから[始]<はじ>まるストーリー\n故事将从那里开始",
    "74220": "[果]<は>てしなく[続]<つづ>く\n并永远延续下去",
    "76220": "winning the soul",
    "89870": "[掴]<つか>め [今]<いま>を[変]<か>えたいなら\n如果想要改变当下 那就紧握住它吧",
    "93100": "[描]<か>いた[夢]<ゆめ>を[未来]<みらい>に[掲]<かか>げ\n把梦想付诸未来",
    "96730": "[恐]<おそ>れないで[挑]<いど>め\n无惧地挑战吧",
    "100050": "[走]<はし>れ[今]<いま>を まだ[終]<お>われない\n奔跑起来吧 还不能停步",
    "103220": "[辿]<たど>り[着]<つ>きたい[場所]<ばしょ>があるから\n因为我仍有未能达成的目标",
    "106830": "その[先]<さき>へと[進]<すす>め\n我将朝着未来前行",
    "109680": "[涙]<なみだ>さえも[強]<つよ>く[胸]<むね>に[抱]<だ>きしめ\n即使落泪也将其紧紧拥在怀中",
    "115800": "そこから[始]<はじ>まるストーリー\n故事将从那里开始",
    "120900": "[果]<は>てしなく[続]<つづ>く\n并永远延续下去",
    "123100": "winning the soul"
  },
