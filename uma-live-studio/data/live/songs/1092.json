  "lyrics": {
    "3400": "[美味]<おい>しすぎてとろけちゃう\n美味到感觉都要融化掉",
    "6333": "[今日]<きょう>もご[馳走様]<ちそうさま>に[大感謝]<だいかんしゃ>\n今天也谢谢你的款待喔",
    "10750": "お[手]<て>を[拝借]<はいしゃく>っ 「いただきまーす!!」\n借用您的贵手「我开动——啦！！」",
    "19600": "はらぺこばっかじゃ[味気]<あじけ>ないね\n肚子空空的话才不好呀",
    "21383": "[美味]<おい>しい[野菜]<やさい>を[育]<そ>てようぜ\n那就种一些好吃的蔬菜吧",
    "23117": "[酸]<す>いも[甘]<あま>いも[噛]<か>み[締]<し>めて[全力収穫]<ぜんりょくしゅうかく>、です！\n不管酸甜苦辣都要咬牙全力收获，的说！",
    "26717": "[食]<く>わず[嫌]<きら>いじゃもったいないね\n不先尝尝就嫌弃的话太浪费了喔",
    "28450": "みんなでドタバタLet's Cooking!\n大家一起啪塔啪塔地下锅！",
    "30250": "[情熱特盛]<じょうねつとくもり>フルコースで さぁ[準備]<じゅんび>OK\n热情满满的大盛宴 来吧已经准备好啦",
    "33850": "[食卓]<しょくたく>[囲]<かこ>めばほら ハピネスが[広]<ひろ>がっていく\n要是围坐在餐桌旁 幸福就会弥漫开来",
    "40267": "[乾杯]<かんぱい>だ！\n干杯呀！",
    "40933": "[美味]<おい>しすぎてとろけちゃう\n美味到感觉都要融化掉",
    "44033": "ココロ ドキドキ わ～～っと[騒]<さわ>いじゃう\n小心脏 怦怦直跳 哇~~的一下哄闹起来",
    "47517": "[湧]<わ>き[上]<あ>がるエナジーを[感]<かん>じたら\n要是感到能量涌动的话",
    "51117": "[今日]<きょう>を[全力]<ぜんりょく>で[駆]<か>け[抜]<ぬ>けるよ\n那么今天就用全力奔向前吧",
    "69800": "[一生]<いっしょう>は[期限]<きげん>[付]<つ>き\n一生如此短暂",
    "73083": "[悔]<くや>しいナミダもスパイスなんだ\n懊悔流下的晶莹泪珠也是人生的调味料",
    "76900": "[困難]<こんなん>なチャレンジにお[預]<あず>けなんてNo Noだ！\n将困难与挑战搁置于后什么的不可以喔！！",
    "82217": "[全部]<ぜんぶ>[美味]<おい>しく[召]<め>し[上]<あ>がっちゃうぞ\n要把所有的美味吃得干干净净喔",
    "87650": "[和食]<わしょく>に[中華]<ちゅうか>、イタリアン？\n日本菜和中国菜，还有意大利料理？",
    "90500": "[今日]<きょう>はどれにしましょう\n今天该选哪个好呢",
    "94083": "「かんぱーい!!」\n「干杯——！！」",
    "94733": "[美味]<おい>しすぎてとろけちゃう\n美味到感觉都要融化掉",
    "97767": "ココロ ドキドキ わ～～っと[騒]<さわ>いじゃう\n小心脏 怦怦直跳 哇~~的一下哄闹起来",
    "101400": "[湧]<わ>き[上]<あ>がるエナジーを[感]<かん>じたら\n要是感到能量涌动的话",
    "104883": "[今日]<きょう>を[全力]<ぜんりょく>で[駆]<か>け[抜]<ぬ>けるよ\n那么今天就用全力奔向前吧",
    "111817": "[今日]<きょう>もご[馳走様]<ちそう>に[大感謝]<だいかんしゃ>\n今天也谢谢你的款待喔",
    "132450": "「ごちそうさまでした!!」\n「谢谢你的款待！！」"
  },
