  "lyrics": {
    "12767": "WINnin' 5",
    "13900": "青空 飛ぶように駆け出そう\n在蓝天之下像飞一样奔跑",
    "18733": "[自分]<いま>を超えてゆけ！\n在现今超越自我吧！",
    "30833": "重ね合わせた夢 笑顔色の勇気をくれた\n梦想彼此交织 微笑也给予我的勇气",
    "36317": "あの日 一緒に見た景色に 未来を映して\n那天一起见到的景色映出了未来",
    "41483": "くじけそうなとき 励まして 支えてくれたね\n在我沮丧的时候给了我鼓励与支持",
    "46633": "そして誓った 絶対 負けないって\n于是我发誓 绝对 不会输",
    "51800": "強い気持ちがつなぐ [心]<ハート>は[Team]<ひとつ>\n强烈的感觉连接着心中的一支队伍",
    "56483": "この瞬間に輝け！\n在这个瞬间闪耀！",
    "64383": "WINnin' 5",
    "65517": "[全員]<みんな>で 叶えてゆく\n所有人一起来实现",
    "69550": "ぶつかり つまずいても\n即使碰壁绊倒了",
    "71633": "走れ！目指せ！ 歓喜の[勝利]<ゴール>\n奔跑吧！目标是！欢喜的胜利 (终点)",
    "74700": "WINnin' 5",
    "75833": "ひとりじゃなかったから\n因为不是独自一人",
    "79467": "そう 強くなれたんだよ\n所以变的更强了呢",
    "81967": "涙の絆 ねぇ ありがとう☆\n眼泪的牵绊 呐 谢谢☆",
    "85833": "劇的フィナーレ!!!\n扣人心弦的结局!!!",
    "87767": "Yes! High-five!!",
    "105667": "WINnin' 5",
    "106800": "[全員]<みんな>で勝ち取ってく\n所有人一起赢得胜利",
    "110833": "限界 追い越せるよ\n超越极限吧",
    "112933": "響け！届け！ [仲間]<とも>の[声援]<エール>\n奏响吧！送达吧！伙伴的声援",
    "116000": "WINnin' 5",
    "117117": "誇りと希望のバトン\n荣誉和希望的接力棒",
    "121000": "ほら 奇跡は続くよ\n看吧 奇迹还在继续呢",
    "123250": "無敵の友情 もう最強☆\n无敌的友情 已经是最强的了☆",
    "127117": "劇的フィナーレ!!!\n扣人心弦的结局!!!",
    "129067": "Yes! High-five!!",
    "131483": "Yeah!! 天晴フィナーレ!!!\nYeah!! 晴天的结局!!!",
    "134217": "最強 5!!\n最强的5人!!",
    "146317": "（せーのっ！）WINnin' 5!!!\n (预─备！)WINnin' 5!!!"
  },
