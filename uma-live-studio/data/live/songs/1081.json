  "lyrics": {
    "8200": "走り出した瞳が目指すのは\n疾驰而出 双目所视之物",
    "12450": "一度しかない “Glorious 1-One- Moment”\n唯有转瞬即逝的 “Glorious 1-One- Moment”",
    "16267": "勝利でしか掴めない奇跡\n斩获独属于胜者的奇迹",
    "30017": "同じ時を彩ってく 輝きたちが 自分を見てるから\n闪耀于同一时代的 璀璨星河 正聚焦于我",
    "34900": "限界なんて決められない 運命がライバル\n不要被划定界限 将命运也视作劲敌",
    "38800": "Believe “dream” 憧れはもう挑戦になったんだ\n坚信“梦想” 昔日的憧憬如今已变作挑战",
    "43600": "Believe “pride” 舞台に立つんだって強い感情\n坚信“荣耀” 傲立舞台之际心中激情涌现",
    "48467": "Believe “Yell” 応えたい気持ちも抱きしめ\n坚信“呼唤” 心怀渴望回应那声音的信念",
    "53450": "いま未来へゲートが開いてく レースが始まってく\n通往未来的门扉已然敞开 比赛业已开幕",
    "61467": "一斉、ターフに吹く風に変わる胸の奥の熱い想いは\n一齐 化作吹拂于赛场的强风 心中所怀的念想逐渐炽热",
    "67917": "誰にも譲れはしないから\n绝不会将胜利拱手相让",
    "71900": "駆け抜けてく速度は私たちの叫びなんだ\n驰骋赛场 这疾速便是我们的怒吼",
    "77500": "競い合うほどに響いてく (Running to the top!)\n愈是交锋愈为响亮 (Running to the top!)",
    "81750": "栄光というゴールへと向かうDestinies! (Glorious Moment!)\n名为荣光的 奔向终点的命运  (Glorious Moment!)",
    "86417": "そう、たった一度 たった一度の奇跡\n哪怕只是仅此一次 唯此一次的奇迹",
    "93650": "走れ！走れ！\n奔跑！疾驰！",
    "98717": "(Running to the top! Running to the top!)",
    "103533": "走れ！走れ！\n奔跑！疾驰！",
    "108567": "(Running to the top! Glorious 1-One- Moment!)"
  },
