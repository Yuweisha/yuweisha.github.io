  "lyrics": {
    "10750": "醒ませ本能を\n觉醒吧 本能之力",
    "12483": "起こせ感動を\n点燃吧 热血激情",
    "14233": "刻め伝説を\n铭刻吧 不朽传说",
    "15750": "叫べ Break Out!!\n放声呐喊 Break Out!!",
    "19350": "(Wo-o-o Wo-o-o)",
    "22383": "(Break Break Break Out!!)",
    "26117": "(Wo-o-o Wo-o-o)",
    "29233": "(Break Break Break Out!!)",
    "30850": "離れていく足音 悔しくないのか？\n渐行渐远的脚步声 你甘心就此认输？",
    "34033": "錆びれていく舞台を前に狼狽えるのか？\n面对日渐腐朽的舞台 还要畏缩踌躇？",
    "37467": "抗って切り開いて見返す番だ\n是时候奋起反抗 开辟天地 让世界见证",
    "40767": "目を離すな歴史を塗り変えてやるさ\n别眨眼 看我们改写历史的轨迹",
    "44533": "だんだんだんだんだんだんアガってく\n心跳节节攀升",
    "48050": "歓声巻き起こすデッドヒート\n欢呼声在激战中炸裂",
    "51200": "だんだんだんだんだんだん迫ってく\n轰鸣步步逼近",
    "54517": "あと少し…せめぎ合う[共鳴]<シンパシー>\n只差毫厘...共鸣的磁场在碰撞",
    "57650": "(Fight on!!) 挑みたい\n(Fight on!!) 我要挑战",
    "59200": "(Fight on!!) 掴みたい\n(Fight on!!) 我要征服",
    "61033": "(Fight on!!) 刻みたい\n(Fight on!!) 我要铭刻",
    "62650": "(Fight on!!) 伝えたい\n(Fight on!!) 我要宣告",
    "64417": "革命の火蓋切って\n燃起革命的烈焰",
    "67217": "伝説の旗掲げてゆこう\n高擎传说的旌旗 前进吧",
    "70600": "さぁ\n此刻",
    "71083": "Legend-Changer",
    "72450": "ロックに飛び込んで\n跃入摇滚的漩涡",
    "73950": "熱狂起こす当事者になれ\n成为掀起狂热的风暴眼",
    "77633": "Legend-Changer",
    "79100": "大胆に行こうぜ\n放肆地冲破桎梏",
    "80283": "本能醒ませ 感動起こせ 伝説刻んで\n唤醒本能 点燃感动 铭刻传奇之名",
    "85783": "大地蹴って蹴って蹴って Break!!\n踏碎大地 破茧而出 Break!!",
    "100600": "無数の足跡にみる栄冠を\n万千足迹铸就的荣光桂冠",
    "104250": "憧れにして終わらせるな\n岂能永远困在憧憬的彼端",
    "107617": "託された夢が堰を切って\n被托付的梦想如洪流冲破堤岸",
    "110617": "今、私の闘志へと変わってゆく\n此刻 尽数化作燎原的斗志冲天",
    "117283": "さぁ\n此刻",
    "117700": "Legend-Changer",
    "119133": "ロックに飛び込んで\n跃入摇滚的漩涡",
    "120750": "熱狂起こす当事者になれ\n成为掀起狂热的风暴眼",
    "124233": "Legend-Changer",
    "125833": "大胆に行こうぜ\n放肆地冲破桎梏",
    "127450": "本能醒ませ 感動起こせ 伝説刻んで\n唤醒本能 点燃感动 铭刻传奇之名",
    "132667": "大地蹴って蹴って蹴って Break!!\n踏碎大地 破茧而出 Break!!",
    "136150": "(Wo-o-o Wo-o-o)",
    "139067": "(Break Break Break Out!!)"
  },
