  "lyrics": {
    "10296": "[選]<えら>ばれしこの[道]<みち>を\n自己选择的道路",
    "13728": "ひたすらに[駆]<か>け[抜]<ぬ>けて\n就应拼尽全力",
    "17160": "[頂点]<ちょうてん>に[立]<た>つ そう[決]<き>めたの！\n我已决定要立于顶点！",
    "20592": "[力]<ちから>の[限]<かぎ>り [先]<さき>へ\n奋力 向前",
    "53625": "[本気]<ほんき>の[夢]<ゆめ>があるから\n正因认真追寻梦想",
    "57057": "[何]<なに>も[恐]<おそ>れたりしない\n才会不惧一切",
    "60060": "こんなもんじゃない\n我的实力绝对不止于此",
    "61776": "[本当]<ほんとう>の[私]<わたし> [見]<み>せてあげる\n就让你见识一下我的全力吧",
    "67353": "[一生]<いっしょう>に[一度]<いちど>きりの\n不想为一生仅有一次的“现在”",
    "70785": "“[今]<いま>”を[後悔]<こうかい>したくない\n留下任何遗憾",
    "73788": "[有言実行]<ゆうげんじっこう> [言葉]<ことば>にしたら\n言出必行的这份话语",
    "77220": "[世界]<せかい>は[動]<う>き[出]<だ>した\n连世界也为之撼动",
    "80652": "[最速]<さいそく>の[輝]<かがや>き\n我用双手紧握住",
    "84084": "この[手]<て>に[掴]<つか>み[取]<と>って\n那最快的光辉",
    "87516": "[新]<あたら>しい[幕]<まく>[開]<あ>けを[越]<こ>えて\n跨越新的帷幕",
    "92664": "[進]<すす>んでゆこう\n继续进发吧",
    "101244": "[情熱]<じょうねつ>に[鳴]<な>り[響]<ひび>く\n被这份热情所震撼",
    "104676": "[高鳴]<たかな>りというファンファーレ\n开场号高声嘹亮",
    "108108": "[抱]<だ>きしめたら [解]<と>き[放]<はな>とう\n我将其拥入怀中 又任其四散",
    "111540": "[目指]<めざ>す[場所]<ばしょ>があるから\n因为我有着坚定的目标",
    "114972": "[選]<えら>ばれしこの[道]<みち>を\n自己选择的道路",
    "118404": "ひたすらに[駆]<か>け[抜]<ぬ>けて\n就应拼尽全力",
    "121836": "[頂点]<ちょうてん>に[立]<た>つ [立]<た>ってみせる！\n我已决定要立于顶点！",
    "124839": "NEXT FRONTIER [見]<み>つめて\n为我见证 NEXT FRONTIER",
    "128700": "[力]<ちから>の[限]<かぎ>り [先]<さき>へ\n奋力 向前"
  },
