  "lyrics": {
    "11750": "Everybody! U! U! U! U! U! U! U!",
    "16633": "Everybody! U! U! U! U Woo～～～",
    "23017": "U U U U U U U U U U U UMA! (Yeah!)",
    "26083": "U U U UMA! U U U U U UMA! (Hoo!)",
    "28767": "U U U U U U U U U U U UMA! (Yeah!)",
    "31467": "U U U UMA! UMA IN AMERICA!",
    "39750": "Say Hey!",
    "42567": "Say Ooh!",
    "44133": "(おーっBANG!)\n(哦—— BANG!)",
    "45817": "世界への登場は派手でなくちゃ\n面向世界的登场必须华丽闪耀",
    "51067": "この勢いがマイ・エンジン (Vroom!)\n这份冲劲就是我的引擎（轰——！）",
    "57050": "[YOU]<きみたち>に見せたい大事なこと\n想展现给你们的重要之事",
    "62300": "それが足と胸のドンドコドンドコドン！ (Wooh!)\n那就是双脚与胸膛的 咚咚咚咚咚！ (Wooh!)",
    "68400": "U U U U U U U U U U U UMA! (Yeah!)",
    "71033": "U U U UMA! UMA IN AMERICA!",
    "74000": "ステージの上から（Let's Go!)\n从舞台之上（Let's Go!)",
    "76633": "世界の向こうまで（Ooh Ooh!）\n直到世界的彼端（Ooh Ooh!）",
    "79683": "遠く届けこのキモチ！\n让这份心意传达到远方吧！",
    "83583": "DOKI DOKI DOKI",
    "85817": "あたしがスーパー・スーパー・スーパーヒーローみた～～～い！ (Hoo)\n我们如同超级・超级・超级英雄～～～！(Hoo)",
    "91333": "ゴールにギュンとガーンとガツンと行くぜ～～～よ！ (Hoo)\n朝着终点嗖地、砰地、咣地冲去～～～！ (Hoo)",
    "96833": "[YOU]<きみ>だけそばにおいで！\n你快来到我身旁！",
    "100367": "[GOAL]<さき>をしめせ！\n指引出终点吧！",
    "102700": "ライン突破！とっぱとっぱしてみせ～～てやる！\n突破极限！突破突破给你看～～～！",
    "107950": "みんなの声で！ (Wooh) \n伴随大家的声音！(Wooh)",
    "110600": "U-MA-MU-SU-ME! (Yeah Ho)",
    "113600": "声を重ねて！ (Wooh) \n让声音重叠！(Wooh)",
    "116133": "U-S-A! おーっBANG!\nU-S-A! 哦——BANG!",
    "120050": "U U U U U U U U U U U UMA! (Yeah!)",
    "122717": "U U U UMA! U U U U U UMA! (Hoo!)",
    "125617": "U U U U U U U U U U U UMA! (Yeah!)",
    "128283": "U U U UMA! UMA IN AMERICA!",
    "136383": "Say U!",
    "138250": "M!",
    "139633": "A!"
  },
