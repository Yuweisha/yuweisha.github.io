  "lyrics": {
    "17317": "期待に応えたくて\n想要不负他人的期待",
    "19483": "願いを叶えたくて\n也要满足自己的愿望",
    "22017": "努力して (工夫して)\n不断努力着 （不断斟酌）",
    "24633": "結果を出すんだ (でも)\n为了取得最好的结果 （但是）",
    "26800": "もっともっともっと大きくなる気持ちを\n却更加更加更加更加燃烧内心的渴望",
    "31733": "(誤魔化せない)\n（也无法掩盖）",
    "33083": "君と知った真剣勝負は\n和与你一同经历真正激烈的较量",
    "36367": "世界が (遅くなって)\n这世界 （正放慢脚步）",
    "39167": "鼓動が (速くなって)\n而心跳 （不断地加速）",
    "41967": "突き抜ける瞬間\n突破极限的瞬间",
    "43950": "何度何度何度何度何度だって\n无论几次几次几次几次几次都",
    "48833": "(楽しくてSmile!)\n（感到如此欣喜 欢笑吧！）",
    "50033": "前進あるのみ心のゆくままに\n不断前进才能实现心中之所愿",
    "55433": "(Start dash)\n（起跑冲刺！）",
    "56200": "最後まで走り抜いて諦めない\n直到最后也不要放弃向前奔跑",
    "60500": "そしていつかの自分を超える時\n而将来当你到了超越自我之时",
    "65217": "(Spurt dash)\n（奋起冲刺！）",
    "65983": "届け (振り絞って)\n传达到吧 （竭尽全力）",
    "68300": "届け (捻り出して)\n传达到吧 （疾驰而出）",
    "71200": "君と一緒に未来描く一直線だ\n与你一同描绘那未来的笔直线",
    "76400": "勝利の向こうへOverrun!\n所向胜利的彼岸飞奔前进",
    "84517": "解き放てTrue power\n解放出真正的全力",
    "94300": "出し切ってGo!\n全力以赴地奔跑吧！",
    "99967": "(だって)\n（因为）",
    "100617": "勝っても負けても\n无论胜利还是败北",
    "102417": "(だって)\n（因为）",
    "103017": "笑顔でいたくて\n都想让你绽放笑颜",
    "105117": "走る走る走る走る君と......\n不断地不断地不断地与你一同奔跑……",
    "112333": "前進あるのみ心が叫ぶから\n不断前进让心灵疾声呼唤",
    "117883": "(Start dash)\n（起跑冲刺！）",
    "118867": "最後まで走り抜いて諦めない\n直到最后也不要放弃向前奔跑",
    "122933": "そしていつかの自分を超えるんだ\n而将来当你到了超越自我之时",
    "127667": "(Spurt dash)\n（奋起冲刺！）",
    "128433": "届け (振り絞って)\n传达到吧 （竭尽全力）",
    "130817": "届け (捻り出して)\n传达到吧 （疾驰而出）",
    "133650": "君と一緒に未来描く一直線だ (さぁ)\n与你一同描绘那未来的笔直线 （那么）",
    "138600": "勝利の向こうへOverrun!\n所向胜利的彼岸飞奔前进!"
  },
